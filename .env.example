STUDIO_BIND=127.0.0.1
STUDIO_PORT=4175
STUDIO_PROVIDER_MODE=chatgpt2api
STUDIO_PROVIDER_URL=http://127.0.0.1:3000
STUDIO_IMAGE_MODEL=gpt-image-2.6-sunburst
# Supply STUDIO_PROVIDER_KEY from a local .env file or secret store.
# Optional. The standard studio works independently.
STUDIO_PUBLIC_ORIGIN=http://127.0.0.1:4175
STUDIO_SUB2_ORIGIN=
STUDIO_SUB2_API_ORIGIN=
STUDIO_SUB2_SECRET=
STUDIO_GITHUB_URL=
# Daily trial limits count generated images. 0 disables trials at that level.
STUDIO_GUEST_DAILY=5
STUDIO_GLOBAL_DAILY=100
STUDIO_GUEST_IP_DAILY=25
# Enable only behind a loopback reverse proxy that overwrites X-Real-IP.
STUDIO_TRUST_LOOPBACK_PROXY=0
# Optional for non-loopback deployments. Install the vision runtime before enabling.
# STUDIO_EDIT_PYTHON=/path/to/vision/venv/bin/python
# STUDIO_EDIT_MODELS=/path/to/vision/models

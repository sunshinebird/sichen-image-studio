{
  "name": "sichen-image-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "local": "node scripts/local.mjs",
    "cases:publish": "node scripts/publish-cases.mjs",
    "test": "node --test tests/*.test.mjs",
    "editor:setup": "node scripts/setup-editor.mjs",
    "local:demo": "node scripts/local.mjs --demo"
  },
  "dependencies": {
    "@nuxt/ui": "4.13.0",
    "fabric": "7.4.0",
    "lucide-vue-next": "0.468.0",
    "pptxgenjs": "4.0.1",
    "reka-ui": "2.11.0",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.5",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.6",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vue-tsc": "3.1.8"
  },
  "license": "MIT"
}
